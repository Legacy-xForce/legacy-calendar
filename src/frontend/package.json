{
  "name": "legacy-calendar-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vue-tsc -b && NODE_ENV=production vite build",
    "preview": "bunx --bun vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,json}\"",
    "generate:api": "bunx openapi-typescript ../backend/openapi.json -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@meteocons/lottie": "^0.1.0",
    "@primeuix/themes": "^3.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.15.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "idb-keyval": "^6.2.2",
    "lottie-web": "^5.13.0",
    "openmeteo": "^1.2.3",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^5.0.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue3-emoji-picker": "^1.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
