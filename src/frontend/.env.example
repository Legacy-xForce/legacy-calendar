# Client build configuration for the Vite app.
#
# These values are inlined into the public client bundle at build time, so they
# are not secrets - never put a value here that must stay private.
# Committed dev/prod baselines live in `.env.development` / `.env.production`;
# use `.env.local` (gitignored) for machine-specific overrides.

# API + realtime endpoints
VITE_API_URL=http://localhost:3000
VITE_UPLOADS_URL=
VITE_WS_URL=
# Legacy Auth (the OpenID Provider) and this app's public client there
VITE_AUTH_URL=https://auth.legacy-group.tech
VITE_OIDC_CLIENT_ID=calendar-spa
VITE_LOG_LEVEL=trace

# Firebase Cloud Messaging (public web client config + public VAPID key)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Google Maps Embed API key
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Bank logos (Brandfetch). Paste your client ID to show real bank logos next to
# IBANs; leave empty to render offline monograms instead.
# https://brandfetch.com/developers/logo-api
VITE_BRANDFETCH_CLIENT_ID=

# PrimeUI license key (community or commercial). Public by design: it ships in
# the client bundle. Get one at https://primeui.dev/license
VITE_PRIMEUI_LICENSE=
