DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Legacy Auth: the OpenID Provider users sign in at, and the issuer of every access token.
AUTH_HOST=https://auth.legacy-group.tech
AUTH_JWKS_URI=https://auth.legacy-group.tech/.well-known/jwks.json
# `iss` expected in Legacy Auth access tokens (defaults to AUTH_HOST). Tokens must also
# list `calendar` in `aud` and carry the calendar scope.
AUTH_ISSUER=https://auth.legacy-group.tech
# Signing in (OpenID Connect, Authorization Code + PKCE). The calendar is the confidential
# client `calendar-web` at Legacy Auth; get its secret with
# POST /admin/oidc/clients/calendar-web/rotate-secret. Required.
OIDC_CLIENT_SECRET=
# Encrypts the tokens stored with each browser session. Required: 32 random bytes,
# base64 (openssl rand -base64 32). Changing it signs everyone out.
SESSION_ENCRYPTION_KEY=
# Optional overrides. Defaults: issuer = AUTH_ISSUER (else AUTH_HOST), client id `calendar-web`,
# redirect URI = first FRONTEND_URL + /auth/callback, post-logout URI = first FRONTEND_URL + /.
# Both URIs must be registered for the client exactly. OIDC_DISCOVERY_URL fetches the discovery
# document from another address (e.g. inside the Docker network); its issuer must still match.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_DISCOVERY_URL=
# Comma-separated list of allowed frontend origins (used for CORS and to build guest magic-invite links).
# Each entry also allows its subdomains with the same scheme and port.
FRONTEND_URL=https://calendar.legacy-group.tech
# Set when running behind a reverse proxy (nginx/Traefik) so rate limiting keys on
# the real client IP. Accepts `true`, a hop count (e.g. `1`) or an Express trust-proxy value.
TRUST_PROXY=
# Optional: pino log level (trace|debug|info|warn|error|fatal). Defaults to info in production.
LOG_LEVEL=

