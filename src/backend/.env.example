DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Signing secret for passkey-issued (HS256) JWTs. Required - the server refuses
# to start without it. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d
# Legacy auth microservice used for login, password changes, and JWT verification.
AUTH_HOST=https://auth.legacy-group.tech
AUTH_JWKS_URI=https://auth.legacy-group.tech/.well-known/jwks.json
# Comma-separated list of allowed frontend origins (used for CORS and to build guest magic-invite links).
# Each entry also allows its subdomains with the same scheme and port.
FRONTEND_URL=https://calendar.legacy-group.tech
# Set when running behind a reverse proxy (nginx/Traefik) so rate limiting keys on
# the real client IP. Accepts `true`, a hop count (e.g. `1`) or an Express trust-proxy value.
TRUST_PROXY=
# Optional: pino log level (trace|debug|info|warn|error|fatal). Defaults to info in production.
LOG_LEVEL=

